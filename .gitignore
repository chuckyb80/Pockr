# Generated VM assets (too large / binary — regenerate with scripts/build_alpine_base.sh)
android/app/src/main/assets/vm/base.qcow2.gz
# android/app/src/main/assets/vm/base.qcow2
# android/app/src/main/assets/vm/*.qcow2*

# Flutter/Dart build artifacts (generated by `flutter pub get` / `flutter build`,
# regenerated by .claude/hooks/session-start.sh on every web session)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
pubspec.lock
android/local.properties
android/app/src/main/java/

# Credentials and secrets only
*.jks
*.apk
# debug.keystore intentionally committed for consistent APK signing across builds
# release.keystore
.env
*.env.*
*_credentials*
credentials.json
service_account*.json
service-account*.json
