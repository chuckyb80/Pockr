# Generated VM assets (too large / binary — regenerate with scripts/build_alpine_base.sh)
android/app/src/main/assets/vm/base.qcow2.gz
# android/app/src/main/assets/vm/base.qcow2
# android/app/src/main/assets/vm/*.qcow2*

# Credentials and secrets only
*.jks
*.apk
# Release signing material never goes in the repo. The one keystore that IS committed is
# the public debug.keystore, kept so debug builds upgrade in place with `adb install -r`.
android/key.properties
*.keystore
!android/app/debug.keystore
.env
*.env.*
*_credentials*
credentials.json
service_account*.json
service-account*.json
